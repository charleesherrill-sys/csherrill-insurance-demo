# Aegis Claims Platform — secret configuration template.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and must
# never be committed. None of these values have an in-source default: the app and
# the docker-compose stack fail to start if any required secret is unset.
#
# Rotate any value that was previously committed to source control before using it.

# Local PostgreSQL password (used by both the db container and the app).
# For local development you may use any value; it is not a shared/production secret.
AEGIS_DB_PASSWORD=

# Bootstrap admin account password. Do NOT reuse the old demo value.
AEGIS_ADMIN_BOOTSTRAP_PASSWORD=

# Payment-gateway API key used to authenticate outbound disburse calls.
AEGIS_PAYMENT_GATEWAY_API_KEY=

# Fraud integration shared secret.
AEGIS_FRAUD_SHARED_SECRET=

# Optional overrides (have safe non-secret defaults in application.properties):
# AEGIS_DB_URL=jdbc:postgresql://localhost:5432/aegis
# AEGIS_DB_USER=aegis
# AEGIS_ADMIN_BOOTSTRAP_USER=admin
# AEGIS_PAYMENT_GATEWAY_URL=https://payments.example-legacy.internal/api
# AEGIS_DOC_ROOT=/var/aegis/uploads
